# ============================================================================
# Menya Ikinyarwanda — Optional Environment Overrides
# ============================================================================
# Note: The app works out-of-the-box for contributors without a .env file.
# Copy this file to `.env` only if you want to point to your own Firebase
# project or custom Android signing keystore.

# Optional custom Android release signing (used by android/app/build.gradle)
# If omitted, local release builds fall back to android/app/debug.keystore
MENYA_RELEASE_STORE_FILE=
MENYA_RELEASE_STORE_PASSWORD=
MENYA_RELEASE_KEY_ALIAS=
MENYA_RELEASE_KEY_PASSWORD=
