{
  "expo": {
    "name": "Menya",
    "slug": "menya",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#20603D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.menya.kinyarwanda"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.menya.kinyarwanda",
      "versionCode": 9,
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.609178588182-c7jje0ta7v7ki1v1rh8vmk8tsrtoi2d9"
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0B6E84"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "390f0327-270d-4da6-a30d-5f67ab561556"
      }
    },
    "owner": "go_daddy"
  }
}
